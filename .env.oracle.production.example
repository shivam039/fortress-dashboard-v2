# Copy this file to .env.oracle.production on the Oracle VM.
# Never commit the real .env.oracle.production file.
#
# This must be a SEPARATE file from .env.oracle.staging, with its own
# DATABASE_URL, FORTRESS_APP_PASSWORD, and FORTRESS_API_KEY — do not reuse
# staging's values here.

FORTRESS_ENV=production
FORTRESS_DB_BACKEND=neon
DATABASE_URL=postgresql+psycopg://prod_user:prod_db_credential@prod-host/prod_db?sslmode=require

FORTRESS_JWT_SECRET=replace-with-output-of-openssl-rand-hex-32
FORTRESS_APP_USERNAME=admin
FORTRESS_APP_PASSWORD=replace-with-the-existing-production-login-phrase
FORTRESS_API_KEY=replace-with-the-existing-production-api-key

# Exact frontend origins that may call this API — the real Vercel
# production domain(s), not a preview/staging origin.
FORTRESS_CORS_ORIGINS=https://your-production-frontend.example.com

# Full universe — this is the live production scan configuration, unlike
# staging's deliberately-small Nifty-50-only default.
FORTRESS_AUTO_SCAN_UNIVERSES=Nifty 50,Nifty Next 50,Nifty Midcap 150,Nifty Smallcap 250
FORTRESS_ENABLE_NEW_FEATURES=false
FORTRESS_LOG_STARTUP=1

# Market-data/provider credentials — the existing production values
# (currently configured on Render), not staging's blank/read-only ones.
INDSTOCKS_TOKEN=
INDSTOCKS_CLIENT_ID=
INDSTOCKS_MPIN=
INDSTOCKS_TOTP_SECRET=
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# Compose/Caddy variables. These are read by docker compose, not the app.
PRODUCTION_API_DOMAIN=api.example.com
