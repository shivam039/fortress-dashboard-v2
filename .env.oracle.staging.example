# Copy this file to .env.oracle.staging on the Oracle VM.
# Never commit the real .env.oracle.staging file.

FORTRESS_ENV=staging
FORTRESS_DB_BACKEND=neon
DATABASE_URL=postgresql+psycopg://staging_user:staging_db_credential@staging-host/staging_db?sslmode=require

# Optional safety guard. Set this to a comma-separated marker from the
# production DATABASE_URL, such as its production host or database name.
# If DATABASE_URL contains any marker while FORTRESS_ENV=staging, startup fails.
FORTRESS_PRODUCTION_DB_MARKERS=prod-host-or-db-name

FORTRESS_JWT_SECRET=replace-with-output-of-openssl-rand-hex-32
FORTRESS_APP_USERNAME=admin
FORTRESS_APP_PASSWORD=replace-with-a-unique-staging-login-phrase
FORTRESS_API_KEY=replace-with-a-unique-staging-api-key

# Exact frontend origins that may call this API.
FORTRESS_CORS_ORIGINS=https://staging-frontend.example.com,http://localhost:3000

# Staging scans must be intentionally small until validated.
FORTRESS_AUTO_SCAN_UNIVERSES=Nifty 50
FORTRESS_ENABLE_NEW_FEATURES=false
FORTRESS_LOG_STARTUP=1

# Market-data/provider credentials, if configured in production, must use
# staging-safe credentials or read-only credentials here.
INDSTOCKS_TOKEN=
INDSTOCKS_CLIENT_ID=
INDSTOCKS_MPIN=
INDSTOCKS_TOTP_SECRET=
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# Compose/Caddy variables. These are read by docker compose, not the app.
STAGING_API_DOMAIN=staging-api.example.com
